NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://foodboll:foodboll@localhost:5432/foodboll
# Must be >= 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# WARNING: local development only. Name-only sign-in (POST /v1/auth/dev-login) lets anyone become
# any user, including an admin. The API refuses to start with it unless NODE_ENV is explicitly
# set to development (or test). Never enable it on a reachable server.
# DEV_LOGIN=true

# The one price every participant pays (KRW), snapshotted onto each match when it is announced.
MATCH_FEE_KRW=10000
# Private, persistent, backed-up directory for payment receipt files.
RECEIPT_DIR=./data/receipts

# --- Telegram: login widget, notifications, bank channel. Set all three or none. ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=             # 16-256 chars of A-Z a-z 0-9 _ -

# --- Automatic payment confirmation (see docs/payments.md) ---
# BANK_WEBHOOK_SECRET=                 # >= 32 chars; enables POST /v1/integrations/bank-notifications
# BANK_SMS_SENDERS=                    # comma-separated sender numbers/names accepted by the webhook
# TELEGRAM_BANK_CHAT_ID=               # private channel that receives the bank alerts
# BANK_AUTO_CONFIRM_LIMIT_PER_10_MIN=30
# BANK_MESSAGE_MAX_AGE_HOURS=36

# --- Limits ---
# RATE_LIMIT_PER_MINUTE=120
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# UPLOAD_RATE_LIMIT_PER_MINUTE=10
# Behind a reverse proxy, so client IPs (rate limiting) are correct. One of: false (default),
# a number of proxy hops (e.g. 1), or a comma-separated list of proxy IPs/CIDRs. "true" trusts
# every X-Forwarded-For hop, so a client can spoof its address: prefer a hop count or CIDR list.
# TRUST_PROXY=false
