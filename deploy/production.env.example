# Copy to .env.production on the server (git-ignored, chmod 600) and fill in real values.
# Compose reads it for variable substitution (--env-file) and passes it to the API container.
#
# Empty values are rejected: a line such as TELEGRAM_BOT_TOKEN= counts as set and fails validation.
# Keep unused optional settings commented out, as below.

# Public hostname. Its DNS A record must point at this server before the first start.
DOMAIN=foodboll.example.com

# Required. URL-safe (it is embedded in DATABASE_URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Required, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=

# Optional. The fee every participant pays in KRW, snapshotted onto each match when announced.
# MATCH_FEE_KRW=10000
# LOG_LEVEL=info

# Telegram: sign-in, notifications and the bank channel. Set all three or none.
# TELEGRAM_BOT_TOKEN=          # from @BotFather
# TELEGRAM_BOT_USERNAME=       # the bot's username without @
# TELEGRAM_WEBHOOK_SECRET=     # 16-256 chars of A-Z a-z 0-9 _ -. Generate: openssl rand -hex 32

# Bank notifications, see docs/payments.md.
# BANK_WEBHOOK_SECRET=         # >= 32 chars. Generate: openssl rand -hex 32
# BANK_SMS_SENDERS=            # comma-separated sender numbers/names
# TELEGRAM_BANK_CHAT_ID=       # id of the private channel that receives bank alerts (negative)
# BANK_AUTO_CONFIRM_LIMIT_PER_10_MIN=30
# BANK_MESSAGE_MAX_AGE_HOURS=36

# Rate limits (per client IP, per minute).
# RATE_LIMIT_PER_MINUTE=120
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# UPLOAD_RATE_LIMIT_PER_MINUTE=10

# Never set in production: DEV_LOGIN (name-only sign-in), NODE_ENV (set by compose), DATABASE_URL
# (built by compose from POSTGRES_PASSWORD), TRUST_PROXY and RECEIPT_DIR (set by compose).
